# ShopVerse: every setting in one place. Copy each block to the place named in its heading. NOTHING here is a secret except where marked.
# Firebase project for ALL three parts: shopverse21-831fc

# ---- customer-app  (Vercel project, Root Directory = customer-app)  ->  see customer-app/.env.example
# NEXT_PUBLIC_FIREBASE_API_KEY=            (Firebase Console > Project settings > Your apps > Web app; public by design)
# NEXT_PUBLIC_FIREBASE_APP_ID=             (same place)
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=shopverse21-831fc
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shopverse21-831fc.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shopverse21-831fc.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=413026494596
# NEXT_PUBLIC_SITE_URL=https://YOUR-SHOP.vercel.app

# ---- admin-panel  (Vercel project, Root Directory = admin-panel)  ->  see admin-panel/.env.example
# same six NEXT_PUBLIC_FIREBASE_* values as above, plus:
# NEXT_PUBLIC_SELLER_API_URL=https://shopverse-seller-approval.YOUR-SUBDOMAIN.workers.dev   (free seller approval; empty = Blaze Cloud Function)
# NEXT_PUBLIC_STOREFRONT_URL=https://YOUR-SHOP.vercel.app

# ---- cloudflare-worker  (Cloudflare dashboard > Worker > Settings > Variables and Secrets)
# FIREBASE_PROJECT_ID=shopverse21-831fc                          (text)
# ALLOWED_ORIGINS=https://YOUR-ADMIN.vercel.app                   (text, exact admin origin)
# SERVICE_ACCOUNT_JSON=<whole key file>                           (SECRET: only ever stored as a Cloudflare secret)

# NEVER put a service-account key in Vercel, in any NEXT_PUBLIC_* variable, in Git, or in chat.
